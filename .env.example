# --- App ---
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
# Comma-separated origins the browser frontend is served from (see frontend/).
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Database ---
# SQLite (zero-setup local dev, default if unset):
DATABASE_URL=sqlite+aiosqlite:///./data/support.db
# Postgres (production):
# DATABASE_URL=postgresql+asyncpg://support:support@localhost:5432/support

# --- LangGraph checkpointer (human-approval interrupt/resume state) ---
# "sqlite" (default, zero-setup, single-instance only - a local file) or
# "postgres" (required once more than one API instance handles
# human-approval interrupts, so any instance can resume a paused run -
# see docs/DEPLOYMENT.md). Postgres mode reuses DATABASE_URL, not a
# separate connection string.
CHECKPOINT_BACKEND=sqlite
CHECKPOINT_DB_PATH=./data/checkpoints.db

# --- Vector store ---
# "memory" (default, zero-setup) or "pgvector"
VECTOR_BACKEND=memory
VECTOR_DIMENSIONS=384

# --- LLM providers (spec §3-8, §44, §48) ---
# MOCK_LLM/DEFAULT_LLM_PROVIDER/FALLBACK_LLM_PROVIDER below are *initial
# values only*: app.main's startup seeds them into the system_settings
# table for the default tenant the first time the app ever boots (spec
# §32/§43), and from then on the database - not this file - is the source
# of truth. Editing them here and restarting has NO effect on an
# already-seeded deployment; change them via
# PUT /api/v1/admin/settings/{key} (ADMIN role) instead - see
# "DB-backed runtime settings" in docs/SECURITY.md. They still matter for
# a brand-new database (nothing to seed from but these) and for any
# tenant besides "default", which starts unseeded.
#
# The entire system must be runnable without paid LLM APIs: MOCK_LLM=true
# (default) makes app.llm.router.get_llm_router() return a deterministic
# mock provider for every purpose, regardless of the settings below.
MOCK_LLM=true

# When MOCK_LLM=false, the router resolves each call's purpose to a model
# profile (see app/llm/profiles.py), each profile to one of these two
# providers, and fails over primary -> retry -> fallback -> raise (the
# caller escalates to a human on total failure) - see docs/ARCHITECTURE.md.
DEFAULT_LLM_PROVIDER=google
FALLBACK_LLM_PROVIDER=xai

# Real secrets/model names - always env-only, never DB-backed (see
# docs/SECURITY.md's "DB-backed runtime settings" allow-list boundary).
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-3.1-flash-lite

XAI_API_KEY=
XAI_MODEL=grok-4-fast

# Optional additional provider (available to any profile via
# DEFAULT_LLM_PROVIDER/FALLBACK_LLM_PROVIDER=anthropic).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- LangSmith tracing/evaluation (spec §13-15) ---
# Opt-in: both must be set for tracing to activate.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=customer-support-workflow

# --- Auth ---
# Signs both customer tokens and staff tokens (a `scope` claim keeps them
# from being interchangeable - see docs/SECURITY.md). Staff accounts are
# real rows in staff_users (see scripts/seed/seed_data.py), authenticated
# via POST /api/v1/staff/login - there is no separate static staff key.
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=60
# spec: Phase 9.1c - encrypts Integration.encrypted_credentials. Blank
# (the default) derives this key from JWT_SECRET instead - fine for
# dev, but means rotating JWT_SECRET also breaks every stored
# integration credential. Set a dedicated value in production (see
# docs/SECURITY.md) so the two secrets rotate independently.
CREDENTIALS_ENCRYPTION_KEY=

# --- Redis (rate-limit counters, optional in dev) ---
# REQUIRED (set to true) in any production deployment running more than
# one API instance - see docs/SECURITY.md's "Rate limiting" section.
# Docker Compose already sets this correctly for you (docker-compose.yml).
REDIS_URL=redis://localhost:6379/0
USE_REDIS=false

# --- Rate limiting ---
RATE_LIMIT_ENABLED=true
# PER_WINDOW/WINDOW_SECONDS: initial values only, seeded into the DB on
# first boot like the LLM settings above - see the note near MOCK_LLM.
RATE_LIMIT_PER_WINDOW=30
RATE_LIMIT_WINDOW_SECONDS=60

# --- Confidence thresholds ---
# Initial values only (seeded into the DB on first boot - see the note
# near MOCK_LLM above), except CONFIDENCE_RESPONSE which stays env-only
# (not yet wired into any decision - see docs/SECURITY.md's known gaps).
CONFIDENCE_INTENT=0.80
# Calibrated for the default hashing-embedder + lexical-weighted reranker;
# raise this if you swap in a real embeddings API/model (see app/rag/embeddings.py)
CONFIDENCE_RETRIEVAL=0.30
CONFIDENCE_RESPONSE=0.85

# --- Retry ---
RETRY_MAX_ATTEMPTS=3

# --- Escalation ---
# Initial value only, seeded into the DB on first boot - see the note near
# MOCK_LLM above.
ESCALATION_MAX_FAILED_ATTEMPTS=2

# --- Security ---
SECURITY_REQUIRE_HUMAN_APPROVAL=true

# --- Cost tracking / budget (spec §42) ---
# Initial value only, seeded into the DB on first boot - see the note near
# MOCK_LLM above. Optional cap on estimated LLM spend per workflow run;
# unset = unlimited. Once a run's model_requests total would exceed this,
# the next LLM-calling node escalates to a human instead of making the call.
LLM_BUDGET_USD_PER_RUN=

# --- OAuth2 (Google Drive / SharePoint docs connectors, spec: Phase 10.4) ---
# Blank by default - only needed if you connect a "docs" integration with
# config.provider "google_drive" or "sharepoint" (Confluence/Notion use a
# static token instead, no OAuth2 needed). Register an app in Google Cloud
# Console / Azure AD first - see docs/DEPLOYMENT.md.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=

MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_TENANT_ID=common
MICROSOFT_OAUTH_REDIRECT_URI=
